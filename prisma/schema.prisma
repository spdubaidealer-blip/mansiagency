datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model RatePackage {
  id       Int    @id @default(autoincrement())
  currency String // "INR" or "AED"
  coins    Int
  price    Float
}

model PaymentSetting {
  id         Int     @id @default(autoincrement())
  type       String  // "UPI", "BotimPay", "duPay", "eMoney"
  details    String  // e.g. UPI ID or Botim number
  qrImageUrl String? // Path to local uploaded QR screenshot
}

model Announcement {
  id       Int     @id @default(autoincrement())
  message  String
  isActive Boolean @default(true)
}

model Order {
  id                String   @id @default(cuid())
  whatsapp          String
  chametId          String
  currency          String
  selectedPackageId Int
  screenshotUrl     String?
  status            String   @default("Pending") // "Pending", "Completed"
  createdAt         DateTime @default(now())
  userEmail         String?  // Link to User email
}

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  otp        String?
  otpExpiry  DateTime?
  isVerified Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

